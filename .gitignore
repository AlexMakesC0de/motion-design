# Local runtime and campaign outputs
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example
work/
outputs/
campaigns/
*.log
.DS_Store
Thumbs.db
.playwright-cli/
node_modules/

# Run artifacts: generated media, job records, the spend ledger. Films and their
# costs are private campaign material, and ATTRIBUTION.md is explicit that
# private campaign files stay out of the repository.
/runs/

# Remotion's own dependency tree (React + a headless browser). Installed on
# demand by `cd render && npm install`; nothing else in the project needs it.
/render/node_modules/

# Saved reference assets (characters, products, screens). Private material,
# like runs/.
/library/
# Example character sheets are made from Library characters: private, kept on
# this machine only. Generations and assets we use never go in the repository.
/skills/character-sheet/assets/
.superpowers/

# Local agent and tool state (Claude Code launch config, gstack logs, design hook cache)
/.claude/
/.gstack/
/.impeccable/hook.cache.json
/transcript

# Videos dropped into the repo to add to the Motion Library (Openjutsu). The
# library's own copies live in runs/jutsu/clips/, already ignored above. Only the
# product trailer in docs/ is part of the repository.
*.mp4
*.mov
*.m4v
*.webm
*.mkv
*.avi
!/docs/images/product/trailer.mp4

# TypeScript incremental build cache
*.tsbuildinfo
