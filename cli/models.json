{
  "_comment": [
    "The ONLY place kie.ai knowledge lives. Skill prose must never carry a model id,",
    "endpoint or price -- see cli/README.md.",
    "",
    "`verified` is false until a real job has succeeded on that model. `kie video` warns",
    "loudly on an unverified model and `kie doctor` reports the count. Flip it by hand",
    "(or let `kie video` flip it on first success) once you've seen output.",
    "",
    "Prices are USD per generation and are ESTIMATES used for budget refusal. kie.ai",
    "exposes no cost-estimate endpoint -- only an account credit balance -- so every",
    "number here was entered by hand and must be reconciled against `kie spend`."
  ],
  "captured": "2026-09-10",
  "staleAfterDays": 30,

  "api": {
    "baseUrl": "https://api.kie.ai",
    "families": {
      "jobs": {
        "create": "/api/v1/jobs/createTask",
        "query": "/api/v1/jobs/recordInfo",
        "queryParam": "taskId",
        "bodyShape": "unified",
        "note": "Unified market API: { model, input, callBackUrl }. Used by all /market/* models."
      },
      "veo": {
        "create": "/api/v1/veo/generate",
        "query": "/api/v1/veo/record-info",
        "queryParam": "taskId",
        "bodyShape": "flat",
        "note": "Veo has its own routes; input fields sit at the top level, not under `input`."
      }
    },
    "credits": "/api/v1/chat/credit",
    "upload": {
      "stream": "/api/file-stream-upload",
      "base64": "/api/file-base64-upload",
      "host": "https://kieai.redpandaai.co",
      "note": "Upload runs on a separate host. `kie doctor` probes both."
    }
  },

  "defaultBudgetUsd": {
    "video": 3.0,
    "image": 0.5,
    "audio": 1.0
  },

  "roles": ["identity", "style", "first_frame", "last_frame", "motion"],

